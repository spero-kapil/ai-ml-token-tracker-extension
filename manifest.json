{
  "manifest_version": 3,
  "name": "AI token usage tracker extension",
  "short_name": "AI Usage Tracker",
  "version": "1.1.0",
  "description": "Shows your remaining ChatGPT usage allowance for your plan's usage periods and the next reset times.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*", "https://*.ngrok-free.app/*", "https://token-tracker.websperotech.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/content/usage-parser.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI token usage tracker",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
